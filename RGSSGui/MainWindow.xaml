<Window x:Class="RGSSGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RGSSGui"
        Title="RGSSGui" Height="600" Width="800"
        MinHeight="400" MinWidth="500">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Open archive" Click="OpenArchive_Click"/>
                <MenuItem x:Name="openRecentMenuItem" Header="Open Recent" IsEnabled="False"/>
                <MenuItem Header="Create archive">
                    <MenuItem Header="V3" Click="CreateV3_Click"/>
                    <MenuItem Header="V1" Click="CreateV1_Click"/>
                </MenuItem>
                <MenuItem x:Name="closeArchiveMenuItem" Header="Close archive" IsEnabled="False" Click="CloseArchive_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem x:Name="extractAllMenuItem" Header="Extract all" IsEnabled="False" Click="ExtractAll_Click"/>
            <MenuItem Header="Tools">
                <MenuItem Header="Register file associations" Click="RegisterFileAssociations_Click"/>
            </MenuItem>
            <MenuItem Header="About" Click="About_Click"/>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="statusLabel"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="261" MinWidth="100"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="100"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <local:MultiSelectTreeView x:Name="treeView" Grid.Row="0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          PreviewMouseLeftButtonDown="TreeView_PreviewMouseLeftButtonDown"
                          SelectedItemChanged="TreeView_SelectedItemChanged">
                    <local:MultiSelectTreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type local:MultiSelectTreeViewItem}">
                            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:MultiSelectTreeView.ItemContainerStyle>
                    <local:MultiSelectTreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Text}"/>
                        </HierarchicalDataTemplate>
                    </local:MultiSelectTreeView.ItemTemplate>
                    <local:MultiSelectTreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Extract selected">
                                <MenuItem Header="With folder structure" Click="ExtractSelected_Click"/>
                                <MenuItem Header="Flat (files only)" Click="ExtractSelectedFlat_Click"/>
                            </MenuItem>
                            <MenuItem Header="Expand all" Click="ExpandAll_Click"/>
                            <MenuItem Header="Collapse all" Click="CollapseAll_Click"/>
                        </ContextMenu>
                    </local:MultiSelectTreeView.ContextMenu>
                </local:MultiSelectTreeView>

                <Grid Grid.Row="1" Margin="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="filterTextBox" TextChanged="FilterTextBox_TextChanged"/>
                        <TextBlock Text="Regexp filter" IsHitTestVisible="False"
                                   Foreground="Gray" Margin="4,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=filterTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="1" Content="Clear" Width="42" Margin="3,0,0,0" Click="ClearFilter_Click"/>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Right panel -->
            <TabControl x:Name="tabControl" Grid.Column="2" SelectionChanged="TabControl_SelectionChanged">
                <TabItem Header="Info">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Path:" VerticalAlignment="Center"/>
                        <TextBox x:Name="pathTextBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="0,2,0,2"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Size:" VerticalAlignment="Center"/>
                        <TextBox x:Name="sizeTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,2,0,2"/>
                    </Grid>
                </TabItem>
                <TabItem Header="Preview">
                    <DockPanel>
                        <TextBlock x:Name="previewInfoLabel" DockPanel.Dock="Top" Margin="4,4,4,2" FontSize="12"/>
                        <ScrollViewer x:Name="previewScrollViewer"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="PreviewScrollViewer_MouseWheel">
                            <Image x:Name="previewImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown"
                                   MouseMove="PreviewImage_MouseMove"
                                   MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp"/>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
